<%- include("header") -%>


<%- include("socialicons") -%>

<div>
  <% if (typeof formError !== "undefined" && formError) { %>
  <p class="text-center" role="alert">Unable to submit form. Please try again.</p>
  <% } %>
  <p id="contact-form-error" class="text-center" role="alert" style="display:none">Unable to submit form. Please try again.</p>
  <form class="message" id="contact-form" action="/contact" method="POST">
    <div class="form-group">
      <input type="text" name="name" class="form-control" id="exampleFormControlInput1" placeholder="you" required>
    </div>

    <div class="form-group">
      <input type="email" name="email" class="form-control" id="exampleFormControlInput1" placeholder="your email" required>
    </div>


    <div class="form-group">
      <textarea class="form-control" name="message" id="exampleFormControlTextarea1" placeholder="what's on your mind?" required rows="3"></textarea>
    </div>
    <br>
    <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
    <!-- Signierter Ladezeitpunkt; wird serverseitig auf Mindest-Ausfuellzeit geprueft -->
    <input type="hidden" name="form_token" value="<%= typeof formToken !== "undefined" ? formToken : "" %>">
    <button class="btn btn-outline-info" style="float: right" type="submit">Send</button>
  </form>
</div>


<script>
  /* Clientseitige Vorpruefung der Mindest-Ausfuellzeit (3 s).
     Nur Komfort - die verbindliche Pruefung passiert auf dem Server. */
  (function () {
    var loadedAt = Date.now();
    var form = document.getElementById("contact-form");
    var errorBox = document.getElementById("contact-form-error");
    form.addEventListener("submit", function (e) {
      if (Date.now() - loadedAt < 3000) {
        e.preventDefault();
        errorBox.style.display = "block";
      }
    });
  })();
</script>

<%- include("footer") -%>
